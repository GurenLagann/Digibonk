{
  "name": "digibonk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "sprites": "node --experimental-strip-types tools/sprites/build.ts",
    "sprites:vpet": "node --experimental-strip-types tools/sprites/build-vpet.ts && node --experimental-strip-types tools/sprites/build-gemini.ts && node --experimental-strip-types tools/sprites/build-dw3.ts",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/db/cli.ts migrate",
    "db:seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/db/cli.ts seed",
    "db:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/db/cli.ts build"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/three": "0.187.0",
    "happy-dom": "20.14.6",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}
